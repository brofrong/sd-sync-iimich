# Binaries
/sd-sync-immich
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Environment
.env
.env.*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store

# Brainstorm companion
.superpowers/

# Wails frontend: dist is built by `npm run build` and embedded by
# frontend/embed.go; keep the directory in git via .gitkeep so the embed
# has something to embed before the first build.
frontend/dist/*
!frontend/dist/.gitkeep
frontend/node_modules/
frontend/bindings/

# Release builds (scripts/build-app.sh <version> dist and the Linux and
# Windows scripts)
/dist/

# Windows resources (icon, manifest, version info) that
# scripts/build-windows.ps1 writes next to main.go for the build only
/cmd/sd-sync-immich/*.syso
